@page "/transfer-report"

@using System.ComponentModel.DataAnnotations
@using System.Threading
@using System.Globalization;
@using SingSiamOffice.Models;
@using AutoGenReports.TimeBaseChecker;
@using System.Text.Json;
@using Microsoft.EntityFrameworkCore;
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage

<Navbar2></Navbar2>

<style>

	th, td {
	padding: 3px;
	}
</style>

<div class="content">
	<Header />

	<div class="container-fluid mt-4 mb-4">
		<div class="row">
			<div class="col-12 mt-4 mb-4">
				<MudText Typo="Typo.h5" Style="@headertext"><img class="rounded-circle" src="img/icons/budget.svg" alt="" style="width:3rem;"> รายงานสรุปการโอนเงิน</MudText>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-4 mb-4">
		<div class="card outer-card">
			<div class="card-body">
				<div class="row">
					<div class="col-md-12 mt-2 mb-2">
						<MudText Typo="Typo.body1" Style="@headertext">ค้นหาข้อมูลรายงานสรุปการโอนเงิน</MudText>
					</div>
					<div class="col-md-3">
						<MudSelect T="int" Label="ระบุปี" HelperText="ระบุปีที่ต้องการหาข้อมูล" @bind-Value="selectedYear" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
							@foreach (var year in allYears)
							{
								<MudSelectItem T="int" Value="@year">@(new DateTime(year, 1, 1).ToString("yyyy"))</MudSelectItem>
							}
						</MudSelect>
					</div>
					<div class="col-md-3">
						<MudSelect T="int" Label="ระบุเดือน" HelperText="ระบุเดือนต้องการหาข้อมูล" @bind-Value="selectedMonth" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
							@foreach (var month in dtfi.MonthNames)
							{
								if (String.IsNullOrEmpty(month)) continue;
								<MudSelectItem T="int" Value="Array.IndexOf(dtfi.MonthNames, month) + 1">@month</MudSelectItem>
							}
						</MudSelect>
					</div>
					<div class="col-md-4">
						<MudStack Row="true" Spacing="1">
							<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Size="Size.Large" Color="Color.Info" OnClick="Search">ค้นหา</MudButton>
							<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" Size="Size.Large" Color="Color.Error" OnClick="Reset">ล้างข้อมูล</MudButton>
						</MudStack>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-4 mb-4">
		<div class="card outer-card">
			<div class="card-body">
				<div class="row">
					<div class="col-md-12 mb-2 mt-2 text-center">
						<MudText Typo="Typo.body1">รายงานสรุปการโอนเงิน : @(monthYearText)</MudText>
						<MudText Typo="Typo.body1">สาขา : @branch.BranchName</MudText>
					</div>
					<div class="col-md-4 mb-2 mt-2 text-center">
						<MudText Typo="Typo.body1">บัญชี เข้า-ออกธนาคาร</MudText>
						<MudText Typo="Typo.body1">ยอดคงเหลือ <span style="@green">: @accountRemain.ToString("N0")</span></MudText>
					</div>
					<div class="col-md-4 mb-2 mt-2 text-center">
						<MudText Typo="Typo.body1">บัญชี รายรับ-รายจ่าย</MudText>
						<MudText Typo="Typo.body1">ยอดคงเหลือ <span style="@green">: @cashRemain.ToString("N0")</span></MudText>
					</div>
					<div class="col-md-4 mb-2 mt-2 text-center">
						<MudText Typo="Typo.body1">บัญชี สรุปรวมยอด</MudText>
						<MudText Typo="Typo.body1">เก็บ <span style="@green">: @savings.ToString("N0")</span> / ปล่อยกู้ <span style="@green">: @loans.ToString("N0")</span></MudText>
					</div>

					<div class="col-md-12">
						@if (report != null && report.JsonData != null)
						{
							jsonModel4? json = JsonSerializer.Deserialize<jsonModel4>(report.JsonData);
							<table class="table">
								<thead>
									<tr>
										<th scope="col">วันที่</th>
										<th scope="col">รายการ</th>
										<th scope="col">จำนวนเงิน</th>
										<th scope="col">อ้างอิง</th>
										<th scope="col">วันที่</th>
										<th scope="col">ผู้ทำรายการ</th>
									</tr>
								</thead>
								<tbody>
									@if (json != null && json.report4_MoneyTransferrings != null)
									{
										foreach (var reportDetails in json.report4_MoneyTransferrings)
										{
											string transferDetailBranch = reportDetails.transfer_detail.Split("|")[1].Trim();
											string transferDetailTitle = reportDetails.transfer_detail.Split("|")[0].Replace(transferDetailBranch, "").Trim();
											<tr>
												<th scope="row">@(DateTime.Parse(reportDetails.transactiondate).ToString("dd MMM yy HH:mm"))</th>
												<td><span style="@green">@reportDetails.status_transfer</span> @transferDetailTitle <span style="@blue">@transferDetailBranch</span></td>
												<td><span style="@green">@reportDetails.amount.ToString("N2")</span></td>
												<td><span style="@black">@reportDetails.ref_tranfer</span></td>
												<td>@(DateTime.Parse(reportDetails.transactiondate_accept).ToString("dd MMM yy HH:mm"))</td>
												<td><span style="@black">@reportDetails.respond_by</span></td>

											</tr>
										}
									}
								</tbody>
							</table>
						}
						else
						{
							<div class="col-md-12 text-center">
								<MudText Typo="Typo.body1" Style="@imporText">ไม่พบข้อมูล</MudText>
							</div>
						}
					</div>

				</div>
			</div>
		</div>
	</div>

</div>
@code {
	// style
	string tableheader = "background-color:#840012; color:#ffff;";
	string headertext = "color:#840012; font-weight:600;";
	string buttoncolor1 = "background-color:#840012; color:#FFF; font-weight:600;";
	string settingbutton = "background-color:#840012; color:#FFF; font-weight:600; ";
	string buttoncollape = "background-color:#fc928c; color:#840012; font-weight:600;";
	string imporText = "color:#840012; font-weight:600;";
	string detailtext = "color:#1C2833 ; font-weight:600; font-style: italic;";

	string green = "color:#00b326; font-weight:600;";
	string blue = "color:#000eb3; font-weight:600;";
	string lightblue = "color:#009bb3; font-weight:600;";
	string orange = "color:#fb4900; font-weight:600;";
	string black = "font-weight:600;";

	private const int REPORT_NUMBER = 4;
	private Branch branch = new Branch();

	private int selectedYear = DateTime.Now.Year;
	private int selectedMonth = DateTime.Now.Month;
	private string monthYearText = "";

	private List<int> allYears = new List<int>();
	private const int INITIAL_YEAR = 2022;

	DateTimeFormatInfo dtfi = DateTimeFormatInfo.CurrentInfo;
	ThaiBuddhistCalendar thaiBuddhistCalendar = new ThaiBuddhistCalendar();

	Report? report = new Report();
	SingsiamdbContext db = new SingsiamdbContext();

	private decimal accountRemain = 0;
	private decimal cashRemain = 0;

	private decimal savings = 0;
	private decimal loans = 0;

	private async Task Initialize(bool first = false)
	{
		selectedYear = DateTime.Now.Year;
		selectedMonth = DateTime.Now.Month;
		monthYearText = new DateTime(selectedYear, selectedMonth, 1).ToString("Y");
		if (first)
		{
			var auth = await localStorage.GetItemAsync<string>("authToken");
			Login? userLogin = db.Logins.Where(s => s.Username == auth).First();
			if (userLogin == null) return;
			branch = db.Branches.Where(s => s.Id == userLogin.BranchId).First();
			allYears = new List<int>();

			for (int i = INITIAL_YEAR; i <= DateTime.Now.Year; i++)
			{
				allYears.Add(i);
			}
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await Initialize(true);
		await FetchRemain();
		await Search();
	}

	private async Task Search()
	{
		monthYearText = new DateTime(selectedYear, selectedMonth, 1).ToString("Y");
		string monthText = selectedMonth.ToString().PadLeft(2, '0');
		report = await db.Reports.Where((report) => report.ReportType == REPORT_NUMBER && report.TransactionDate != null && report.TransactionDate.Contains($"{selectedYear}-{monthText}-")).FirstOrDefaultAsync();

		await FetchAccountSummary();
	}

	private async Task Reset()
	{
		await Initialize();
		await Search();
	}

	private async Task FetchRemain()
	{
		var list_transection = await db.TransactionHistories.Include(s => s.Subject).Include(s => s.Login).Where(s => s.BranchId == branch.Id).AsNoTracking().OrderByDescending(s => s.CreateAt).ToListAsync();

		var to_calulate = list_transection.Where(s => !(s.SubjectId == 21 && s.ConfirmTransection == false) && s.Subject.SubjectType != 34).ToList();
		var total_income = to_calulate.Where(s => s.Subject.SubjectType == 1);
		var total_expent = to_calulate.Where(s => s.Subject.SubjectType == 2);
		var false_confirm = total_expent.Where(s => s.SubjectId == 4 && s.ConfirmTransection == false).ToList();
		var deposit = to_calulate.Where(s => s.Subject.SubjectType == 4).Sum(s => s.Price); //ฝาก
		var withdraw = to_calulate.Where(s => s.Subject.SubjectType == 3).Sum(s => s.Price); //ถอน

		accountRemain = total_income.Where(s => s.PaymentMethod == 2).Sum(s => s.Price) - total_expent.Where(s => s.PaymentMethod == 2).Sum(s => s.Price) + false_confirm.Sum(s => s.Price) + deposit - withdraw; //ยอดคงเหลือในบัญชี
		cashRemain = total_income.Where(s => s.PaymentMethod == 1).Sum(s => s.Price) - total_expent.Where(s => s.PaymentMethod == 1).Sum(s => s.Price) + withdraw - deposit; //ยอดคงเหลือเงินสด
	}

	private async Task FetchAccountSummary()
	{
		string monthText = selectedMonth.ToString().PadLeft(2, '0');
		var reports = await db.Reports.Where((report) => report.ReportType == 3 && report.TransactionDate != null && report.TransactionDate.Contains($"{selectedYear}-{monthText}-")).ToListAsync();
		decimal savings = 0;
		decimal loans = 0;
		foreach (Report report in reports)
		{
			if (report.JsonData == null || report.TransactionDate == null) continue;
			jsonModel3? json = JsonSerializer.Deserialize<jsonModel3>(report.JsonData);

			@if (json == null || json.report3_Summary_Of_Months == null) continue;
			foreach (var summary in json.report3_Summary_Of_Months)
			{
				savings += summary.total_sum_amount;
				loans += summary.total_promise;
			}
		}
		this.savings = savings;
		this.loans = loans;
	}
}
