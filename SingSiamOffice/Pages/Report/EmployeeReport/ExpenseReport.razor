					</div>

					<div class="col-md-12">
						<div class="col-md-12 mb-2 mt-2">
							<MudText Typo="Typo.body2" Style="@blue">02 กันยายน 2567</MudText>
						</div>
						<table class="table">

							<thead>
								<tr>
									<th scope="col" class="col-1">ที่</th>
									<th scope="col" class="col-8">รายการ</th>
									<th scope="col" class="col-2 text-end">รายจ่าย</th>

								</tr>
							</thead>
							<tbody>
								<tr>
									<th scope="row">1</th>
									<td>ค่าใช้จ่ายอื่นๆ <span style="@orange">: ค่าน้ำยาถูพื้นสำนักงาน</span></td>
									<td class="text-end"><span style="@orange">39.00</span></td>

								</tr>
								<tr>
									<th scope="row">2</th>
									<td>ค่าใช้จ่ายอื่นๆ <span style="@orange">: ค่าน้ำมันรถ</span></td>
									<td class="text-end"><span style="@orange">100.00</span></td>

								</tr>
							</tbody>
						</table>
					</div>

					<div class="col-md-12">
						<div class="col-md-12 mb-2 mt-2">
							<MudText Typo="Typo.body2" Style="@blue">05 กันยายน 2567</MudText>
						</div>
						<table class="table">

							<thead>
								<tr>
									<th scope="col" class="col-1">ที่</th>
									<th scope="col" class="col-8">รายการ</th>
									<th scope="col" class="col-2 text-end">รายจ่าย</th>

								</tr>
							</thead>
							<tbody>
								<tr>
									<th scope="row">1</th>
									<td>ค่าใช้จ่ายอื่นๆ <span style="@orange">: ค่างวดรถ</span></td>
									<td class="text-end"><span style="@orange">20,000.00</span></td>

								</tr>

							</tbody>
						</table>
					</div>

					<div class="col-md-12">
						<div class="col-md-12 mb-2 mt-2">
							<MudText Typo="Typo.body2" Style="@blue">09 กันยายน 2567</MudText>
						</div>
						<table class="table">

							<thead>
								<tr>
									<th scope="col" class="col-1">ที่</th>
									<th scope="col" class="col-8">รายการ</th>
