					@foreach (Report report in records)
					{
						if (report.JsonData == null || report.TransactionDate == null) continue;
						jsonModel6? json = JsonSerializer.Deserialize<jsonModel6>(report.JsonData);
						CultureInfo culture = new CultureInfo("en-US");
						DateTime transactionDate = DateTime.Parse(report.TransactionDate, culture);

						<div class="col-md-12">
							<div class="col-md-12 mb-2 mt-2">
								<MudText Typo="Typo.body2" Style="@blue">@transactionDate.Day @NumberToMonthText(transactionDate.Month) @(transactionDate.Year + 543)</MudText>
							</div>
							<table class="table">

								<thead>
									<tr>
										<th scope="col" class="col-1">ที่</th>
										<th scope="col" class="col-8">รายการ</th>
										<th scope="col" class="col-2 text-end">รายจ่าย</th>

									</tr>
								</thead>
								<tbody>
									@if (json == null || json.report6_Summary_Expenses == null) continue;
									@foreach (var reportDetails in json.report6_Summary_Expenses)
									{
										<tr>
											<th scope="row">@reportDetails.rowNumber</th>
											<td>@reportDetails.detail <span style="@orange">@reportDetails.detail_desc</span></td>
											<td class="text-end"><span style="@orange">@reportDetails.expenses_amount</span></td>

										</tr>
										total_expenses += reportDetails.expenses_amount;
									}
								</tbody>
							</table>
							<table class="table">

								<thead>
									<tr>
										<th scope="col" class="col-9 text-end">ทั้งหมด</th>
										<th scope="col" class="col-2 text-end">@total_expenses</th>

									</tr>
								</thead>

							</table>
						</div>
					}
				</div>

			</div>
		</div>
	</div>

</div>
@code {
	// style
	string tableheader = "background-color:#840012; color:#ffff;";
	string headertext = "color:#840012; font-weight:600;";
	string buttoncolor1 = "background-color:#840012; color:#FFF; font-weight:600;";
	string settingbutton = "background-color:#840012; color:#FFF; font-weight:600; ";
	string buttoncollape = "background-color:#fc928c; color:#840012; font-weight:600;";
	string imporText = "color:#840012; font-weight:600;";
	string detailtext = "color:#1C2833 ; font-weight:600; font-style: italic;";

	string green = "color:#00b326; font-weight:600;";
	string blue = "color:#000eb3; font-weight:600;";
	string lightblue = "color:#009bb3; font-weight:600;";
	string orange = "color:#fb4900; font-weight:600;";
	string black = "font-weight:600;";

	List<Report> records = new List<Report>();
	SingsiamdbContext db = new SingsiamdbContext();
	decimal total_expenses = 0;

	private string year_data { get; set; }
	private string[] years =
	{
		"2565", "2566", "2567", "2568",
	};

	private string month_data { get; set; }
	private string[] months =
	{
		"มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
		"กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"
	};

	private void Initialize()
	{
		year_data = "";
		month_data = "";
		DateTime now = DateTime.Now;
		int year = now.Year;
		int month = now.Month;
		string monthText = month.ToString().PadLeft(2, '0');
		List<Report> reportList = db.Reports.Where((report) => report.ReportType == 6 && report.TransactionDate != null && report.TransactionDate.Contains($"{year}-{monthText}-")).ToList();
		records = reportList;
	}

	private void Search()
	{
		if (string.IsNullOrEmpty(year_data) || string.IsNullOrEmpty(month_data))
		{
			return;
		}
		total_expenses = 0;
		int year = YearTextToNumber(year_data);
		int month = MonthTextToNumber(month_data);
		string monthText = month.ToString().PadLeft(2, '0');
		List<Report> reportList = db.Reports.Where((report) => report.ReportType == 6 && report.TransactionDate != null && report.TransactionDate.Contains($"{year}-{monthText}-")).ToList();
		records = reportList;
	}

	private void Reset()
	{
		Initialize();
		StateHasChanged();
	}

	protected override void OnAfterRender(bool firstRender)
	{
		total_expenses = 0;
		base.OnAfterRender(firstRender);
	}

	protected override void OnInitialized()
	{
		Initialize();
		StateHasChanged();
	}

	private int MonthTextToNumber(string month)
	{
		switch (month)
		{
			case "มกราคม":
				return 1;
			case "กุมภาพันธ์":
				return 2;
			case "มีนาคม":
				return 3;
			case "เมษายน":
				return 4;
			case "พฤษภาคม":
				return 5;
			case "มิถุนายน":
				return 6;
			case "กรกฎาคม":
				return 7;
			case "สิงหาคม":
				return 8;
			case "กันยายน":
				return 9;
			case "ตุลาคม":
				return 10;
			case "พฤศจิกายน":
				return 11;
			case "ธันวาคม":
				return 12;
			default:
				return 0;
		}
	}

	private string NumberToMonthText(int monthText)
	{
		// generate month number
		switch (monthText)
		{
			case 1:
				return "มกราคม";
			case 2:
				return "กุมภาพันธ์";
			case 3:
				return "มีนาคม";
			case 4:
				return "เมษายน";
			case 5:
				return "พฤษภาคม";
			case 6:
				return "มิถุนายน";
			case 7:
				return "กรกฎาคม";
			case 8:
				return "สิงหาคม";
			case 9:
				return "กันยายน";
			case 10:
				return "ตุลาคม";
			case 11:
				return "พฤศจิกายน";
			case 12:
				return "ธันวาคม";
			default:
				return "";
		}
	}

	private int YearTextToNumber(string year)
	{
		return int.Parse(year) - 543;
	}
}
