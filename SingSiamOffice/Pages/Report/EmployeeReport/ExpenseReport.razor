	<div class="container-fluid mt-4 mb-4">
		<div class="card outer-card">
			<div class="card-body">
				<div class="row">
					<div class="col-md-12 mt-2 mb-2">
						<MudText Typo="Typo.body1" Style="@headertext">ค้นหาข้อมูลสรุปรายการค่าใช้จ่าย</MudText>
					</div>
					<div class="col-md-3">
						<MudSelect T="string" Label="ระบุปี" HelperText="ระบุปีที่ต้องการหาข้อมูล" @bind-Value="year_data" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
							@foreach (var year in years)
							{
								<MudSelectItem T="string" Value="@year">@year</MudSelectItem>
							}
						</MudSelect>
					</div>
					<div class="col-md-3">
						<MudSelect T="string" Label="ระบุเดือน" HelperText="ระบุเดือนต้องการหาข้อมูล" @bind-Value="month_data" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
							@foreach (var month in months)
							{
								<MudSelectItem T="string" Value="@month">@month</MudSelectItem>
							}
						</MudSelect>
					</div>
					<div class="col-md-4">
						<MudStack Row="true" Spacing="1">
							<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Size="Size.Large" Color="Color.Info" @onclick="()=>Search()">ค้นหา</MudButton>
							<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" Size="Size.Large" Color="Color.Error" @onclick="()=>Reset()">ล้างข้อมูล</MudButton>
						</MudStack>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-4 mb-4">
		<div class="card outer-card">
			<div class="card-body">
				<div class="row">
					<div class="col-md-12 mb-2 mt-2 text-center">
						<MudText Typo="Typo.body1">สรุปรายการค่าใช้จ่าย : กันยายน 2567</MudText>
						<MudText Typo="Typo.body1">สาขา : ย่อยบ้านเขว้า</MudText>
					</div>


					@* <div class="col-md-12">
						<div class="col-md-12 mb-2 mt-2">
							<MudText Typo="Typo.body2" Style="@blue">01 กันยายน 2567</MudText>
						</div>
						<table class="table">

							<thead>
								<tr>
									<th scope="col" class="col-1">ที่</th>
									<th scope="col" class="col-8">รายการ</th>
									<th scope="col" class="col-2 text-end">รายจ่าย</th>

								</tr>
							</thead>
							<tbody>
								<tr>
									<th scope="row">1</th>
									<td>ค่าใช้จ่ายอื่นๆ <span style="@orange">: ค่าเก็บขยะมูลฝอยรายปีของเทศบาลตําบลบ้านเขว้า</span></td>
									<td class="text-end"><span style="@orange">120.00</span></td>

