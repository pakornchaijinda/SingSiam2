@page "/montlyIncome-report"

@using System.ComponentModel.DataAnnotations
@using System.Threading
@using System.Globalization;
@using SingSiamOffice.Models;
@using AutoGenReports.TimeBaseChecker;
@using System.Text.Json;
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage

<Navbar2></Navbar2>

<style>

	th, td {
		padding: 3px;
	}
</style>

<div class="content">
	<Header />

	<div class="container-fluid mt-4 mb-4">
		<div class="row">
			<div class="col-12 mt-4 mb-4">
				<MudText Typo="Typo.h5" Style="@headertext"><img class="rounded-circle" src="img/icons/budget.svg" alt="" style="width:3rem;"> รายงานสรุปรายรับประจําเดือน</MudText>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-4 mb-4">
		<div class="card outer-card">
			<div class="card-body">
				<div class="row">
					<div class="col-md-12 mt-2 mb-2">
						<MudText Typo="Typo.body1" Style="@headertext">ค้นหาข้อมูลรายงานสรุปรายรับประจําเดือน</MudText>
					</div>
					<div class="col-md-3">
						<MudSelect T="int" Label="ระบุปี" HelperText="ระบุปีที่ต้องการหาข้อมูล" @bind-Value="selectedYear" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
							@foreach (var year in allYears)
							{
								<MudSelectItem T="int" Value="@year">@(new DateTime(year, 1, 1).ToString("yyyy"))</MudSelectItem>
							}
						</MudSelect>
					</div>
					<div class="col-md-3">
						<MudSelect T="int" Label="ระบุเดือน" HelperText="ระบุเดือนต้องการหาข้อมูล" @bind-Value="selectedMonth" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
							@foreach (var month in dtfi.MonthNames)
							{
								if (String.IsNullOrEmpty(month)) continue;
								<MudSelectItem T="int" Value="Array.IndexOf(dtfi.MonthNames, month) + 1">@month</MudSelectItem>
							}
						</MudSelect>
					</div>
					<div class="col-md-4">
						<MudStack Row="true" Spacing="1">
							<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Size="Size.Large" Color="Color.Info" OnClick="Search">ค้นหา</MudButton>
							<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" Size="Size.Large" Color="Color.Error" OnClick="Reset">ล้างข้อมูล</MudButton>
						</MudStack>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-4 mb-4">
		<div class="card outer-card">
			<div class="card-body">
				<div class="row">
					<div class="col-md-12 mb-2 mt-2 text-center">
						<MudText Typo="Typo.body1">รายงานสรุปรายรับประจําเดือน : @(monthYearText)</MudText>
						<MudText Typo="Typo.body1">สาขา : @branch.BranchName</MudText>
					</div>

					<div class="col-md-12">
						<table class="table">
							<thead>
								<tr>
									<th></th>
									<th scope="col" colspan="6" class="text-center">รายการชำระค่างวด</th>
									<th scope="col" colspan="2" class="text-center">รายการรับเงิน</th>
									<th scope="col" colspan="2" class="text-center">รายการปล่อยกู้</th>

								</tr>
							</thead>
							<thead>
								<tr>
									<th scope="col">ว/ด/ป</th>
									<th scope="col">ค่างวด</th>
									<th scope="col">ค่าปรับ</th>
									<th scope="col">รวม</th>
									<th scope="col">ค่างวด</th>
									<th scope="col">ค่าปรับ</th>
									<th scope="col">รวม</th>
									<th scope="col">รวมเงิน</th>
									<th scope="col">total</th>
									<th scope="col">ปล่อยกู้</th>
									<th scope="col">รวมเงิน</th>
								</tr>
							</thead>
							<tbody>
								@if (records.Count == 0)
								{
									<tr class="text-center">
										<th colspan="10">
											<MudText Class="w-100" Typo="Typo.body1" Style="@imporText">ไม่พบข้อมูล</MudText>
										</th>
									</tr>
								}
								@{
									decimal totalAmountVat = 0;
									decimal totalAmountChargeVat = 0;
									decimal totalTotalVat = 0;
									decimal totalAmountNoVat = 0;
									decimal totalAmountChargeNoVat = 0;
									decimal totalTotalNoVat = 0;
									decimal totalTotalSumAmount = 0;
									decimal totalTotalAccumulate = 0;

									int numberOfVat = 0;
									int numberOfNoVat = 0;
								}
								@foreach (Report report in records)
								{
									if (report.JsonData == null || report.TransactionDate == null) continue;
									jsonModel3? json = JsonSerializer.Deserialize<jsonModel3>(report.JsonData);
									DateTime transactionDate = DateTime.Parse(report.TransactionDate, new CultureInfo("en-US"));

									@if (json == null || json.report3_Summary_Of_Months == null) continue;
									@foreach (var reportDetails in json.report3_Summary_Of_Months)
									{
										<tr>
											<th scope="row">@reportDetails.transaction_data.ToString("dd MMM yy")</th>
											<td><span style="@lightblue">@reportDetails.amount_vat</span></td>
											<td><span style="@lightblue">@reportDetails.amount_charge_vat</span></td>
											<td><span style="@lightblue">@reportDetails.total_vat</span></td>
											<td><span style="@orange">@reportDetails.amount_novat</span></td>
											<td><span style="@orange">@reportDetails.amount_charge_novat</span></td>
											<td><span style="@orange">@reportDetails.total_novat</span></td>
											<td><span style="@blue">@reportDetails.total_sum_amount</span></td>
											<td><span style="@blue">@reportDetails.total_accumulate</span></td>
											<td><span style="@orange">@reportDetails.total_promise</span></td>
											<td><span style="@orange">@reportDetails.total_accumulate_promise</span></td>
										</tr>
										totalAmountVat += reportDetails.amount_vat;
										totalAmountChargeVat += reportDetails.amount_charge_vat;
										totalTotalVat += reportDetails.total_vat;

										totalAmountNoVat += reportDetails.amount_novat;
										totalAmountChargeNoVat += reportDetails.amount_charge_novat;
										totalTotalNoVat += reportDetails.total_novat;

										totalTotalSumAmount += reportDetails.total_sum_amount;
										totalTotalAccumulate = reportDetails.total_accumulate;

										if (reportDetails.amount_vat != 0) numberOfVat++;
										if (reportDetails.amount_novat != 0) numberOfNoVat++;
									}
								}
							</tbody>
							<tfoot>
								<tr style="@tablefooter">
									<th scope="row">รวม</th>
									<td>@totalAmountVat</td>
									<td>@totalAmountChargeVat</td>
									<td>@totalTotalVat</td>
									<td>@totalAmountNoVat</td>
									<td>@totalAmountChargeNoVat</td>
									<td>@totalTotalNoVat</td>
									<td>@totalTotalSumAmount</td>
									<td>@totalTotalAccumulate</td>
									<td></td>
									<td>153,000</td>

								</tr>
								<tr class="text-end border-white" style="@totalfooter">
									<th></th>
									<td colspan="2">ยอดเก็บ Vat</td>
									<td>@numberOfVat</td>
									<td>ราย</td>
									<td colspan="2"></td>
									<td colspan="2">ล/ค ประจําเดือนก่อน</td>
									<td>220</td>
									<td>ราย</td>
								</tr>
								<tr class="text-end border-white" style="@totalfooter">
									<th></th>
									<td colspan="2"> ยอดเก็บ Hide</td>
									<td>@numberOfNoVat</td>
									<td>ราย</td>
									<td colspan="2"></td>
									<td colspan="2">ล/ค ประจําเดือนนี้</td>
									<td>220</td>
									<td>ราย</td>
								</tr>
								<tr class="text-end border-white" style="@totalfooter">
									<th></th>
									<td colspan="2">รวม</td>
									<td>@(numberOfVat + numberOfNoVat)</td>
									<td>ราย</td>
									<td colspan="2"></td>
									<td colspan="2"></td>
									<td></td>
									<td></td>
								</tr>
								<br />
								<tr class="text-end border-white" style="@totalfooter">
									<th></th>
									<td colspan="2"></td>
									<td></td>
									<td></td>
									<td colspan="2"></td>
									<td colspan="2">รายรับรวม</td>
									<td>@totalTotalSumAmount</td>
									<td>บาท</td>
								</tr>
								<tr class="text-end border-white" style="@totalfooter">
									<th></th>
									<td colspan="2"></td>
									<td></td>
									<td></td>
									<td colspan="2"></td>
									<td colspan="2">รายจ่ายรวม</td>
									<td>@expense</td>
									<td>บาท</td>
								</tr>
								<tr class="text-end border-white" style="@totalfooter">
									<th></th>
									<td colspan="2"></td>
									<td></td>
									<td></td>
									<td colspan="2"></td>
									<td colspan="2">กำไรขั้นต้น</td>
									<td>@(totalTotalSumAmount - expense)</td>
									<td>บาท</td>
								</tr>
							</tfoot>

						</table>
					</div>

				</div>
			</div>
		</div>
	</div>

</div>
@code {
	// style
	string tableheader = "background-color:#840012; color:#ffff;";
	string tablefooter = "background-color:#840012; color:#ffff;";
	string totalfooter = "background-color:#ffff;color:#840012;border-bottom: none; border:none; padding: 2px; font-weight:600;";
	string headertext = "color:#840012; font-weight:600;";
	string buttoncolor1 = "background-color:#840012; color:#FFF; font-weight:600;";
	string settingbutton = "background-color:#840012; color:#FFF; font-weight:600; ";
	string buttoncollape = "background-color:#fc928c; color:#840012; font-weight:600;";
	string imporText = "color:#840012; font-weight:600;";
	string detailtext = "color:#1C2833 ; font-weight:600; font-style: italic;";

	string green = "color:#00b326; font-weight:600;";
	string blue = "color:#000eb3; font-weight:600;";
	string lightblue = "color:#009bb3; font-weight:600;";
	string orange = "color:#fb4900; font-weight:600;";
	string black = "font-weight:600;";

	private const int REPORT_NUMBER = 3;
	private Branch branch = new Branch();

	private int selectedYear;
	private int selectedMonth;
	private string monthYearText = "";

	private List<int> allYears = new List<int>();
	private const int INITIAL_YEAR = 2022;

	DateTimeFormatInfo dtfi = DateTimeFormatInfo.CurrentInfo;
	ThaiBuddhistCalendar thaiBuddhistCalendar = new ThaiBuddhistCalendar();

	List<Report> records = new List<Report>();
	SingsiamdbContext db = new SingsiamdbContext();

	private decimal expense;

	private async Task Initialize(bool first = false)
	{
		selectedYear = DateTime.Now.Year;
		selectedMonth = DateTime.Now.Month;
		monthYearText = new DateTime(selectedYear, selectedMonth, 1).ToString("Y");
		if (first)
		{
			var auth = await localStorage.GetItemAsync<string>("authToken");
			Login? userLogin = db.Logins.Where(s => s.Username == auth).First();
			if (userLogin == null) return;
			branch = db.Branches.Where(s => s.Id == userLogin.BranchId).First();
			allYears = new List<int>();

			for (int i = INITIAL_YEAR; i <= DateTime.Now.Year; i++)
			{
				allYears.Add(i);
			}
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await Initialize(true);
		Search();
	}

	private void Search()
	{
		monthYearText = new DateTime(selectedYear, selectedMonth, 1).ToString("Y");
		string monthText = selectedMonth.ToString().PadLeft(2, '0');
		List<Report> reportList = db.Reports.Where((report) => report.ReportType == REPORT_NUMBER &&
			report.BranchId == branch.Id &&
			report.TransactionDate != null &&
			report.TransactionDate.Contains($"{selectedYear}-{monthText}-")).ToList();
		records = reportList;
		expense = db.TransactionHistories
			.Where((history) => history.SubjectId >= 11 && history.SubjectId <= 17
				&& history.CreateAt.Year == selectedYear && history.CreateAt.Month == selectedMonth)
			.Sum((history) => history.Price);
	}

	private async Task Reset()
	{
		await Initialize();
		Search();
	}
}
