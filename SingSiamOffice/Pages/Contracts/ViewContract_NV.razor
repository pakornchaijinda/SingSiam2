                }
                @if (detailPromise.Ptype == 2)
                {
                    <MudText Typo="Typo.body1">ประเภทสัญญา : <MudChip Variant="Variant.Filled" Color="Color.Warning">สัญญาเงินกู้</MudChip></MudText>
                }
            </div>
            <div class="card-body">
