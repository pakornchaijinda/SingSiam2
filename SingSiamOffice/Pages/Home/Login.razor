@page "/"
@page "/login"
@layout BlankLayout
@using SingSiamOffice.Authentication
@using SingSiamOffice.Manage
@using Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Blazored.LocalStorage
@inject UserAccountService userAccountService
@inject AuthenticationStateProvider authStateProvider
@inject ILocalStorageService localStorage
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject IAuthenticationService AuthenticationService
@inject Manage.GlobalData globalData
@inject Manage.UserManagement _userManager
@inject Manage.EventLog eventLog
@inject Manage.BranchService branchService
@inject SingsiamdbContext db

<head>
    <link rel="stylesheet" href="../Pages/Home/Login.razor.css">
</head>

<!-- Sign In Start -->
<div class="container-fluid">
    <div class="row h-100 align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4">
            <div class="bg-light rounded p-4 p-sm-5 my-4 mx-3">
                <div class="text-center mb-3">
                    <img class="rounded-circle" src="img/icons/icon.svg" alt="" style="width:20rem;">
                </div>
                <div class="form-floating mb-3">
                    <MudTextField id="username" @bind-Value="username" Label="ชื่อผู้ใช้งาน" Variant="Variant.Outlined"></MudTextField>
                </div>
                <div class="form-floating mb-4">
                    <MudTextField @bind-Value="password" Label="รหัสผ่าน" Variant="Variant.Outlined" InputType="@PasswordInput"
                                  Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="TogglePasswordVisibility"
                                  AdornmentAriaLabel="Show Password"></MudTextField>
                </div>
                <button type="submit" style="@buttonStyle" class="btn btn-primary py-3 w-100 mb-4" @onclick="Submit">ลงชื่อเข้าใช้งาน</button>
            </div>
        </div>
    </div>
</div>
<!-- Sign In End -->
@code {
    private string username { get; set; }
    private string password { get; set; }
    private string buttonStyle = "background-color:#840012; color:#ffff;";
    private bool isPasswordVisible;
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
        PasswordInput = isPasswordVisible ? InputType.Text : InputType.Password;
        PasswordInputIcon = isPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userLogin = await localStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(userLogin))
            {
                var branch = await db.Logins
                    .Where(s => s.Username == userLogin)
                    .Include(s => s.Branch)
                    .FirstOrDefaultAsync();

                if (branch != null)
                {
                    globalData.username = username;
                    globalData.fullname = branch.Fullname;
                    globalData.branch_name = branch.Branch.BranchName;
                    branchService.branch_ID = branch.Branch.Id;
                    globalData.login_id = branch.Id;
                    eventLog.Update_by = await _userManager.GetUserIdAsync(userLogin);

                    var eventLogEntry = new SingSiamOffice.Models.EventLog
                        {
                            Uuid = Guid.NewGuid(),
                            TableName = "login",
                            Opertation = "Online",
                            UpdateBy = eventLog.Update_by
                        };

                    await _userManager.AddEventLogAsync(eventLogEntry);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during initialization: {ex.Message}");
        }
    }

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(username) || string.IsNullOrEmpty(password))
        {
            await JSRuntime.InvokeVoidAsync("alert_error");
            return;
        }

        var result = await AuthenticationService.Login(new AuthenticationUserModel { UserName = username, Password = password });

        if (result == null)
        {
            await JSRuntime.InvokeVoidAsync("alert_login_fail");
            return;
        }

        eventLog.Update_by = await _userManager.GetUserIdAsync(username);

        if (result.RoleName == "Admin" || result.RoleName == "หัวหน้า chief")
        {
            NavManager.NavigateTo("/dashboard-admin", true);
        }
        else
        {
            var branch = await db.Logins
                .Where(s => s.Username == username)
                .Include(s => s.Branch)
                .FirstOrDefaultAsync();

            if (branch != null)
            {
                globalData.username = username;
                globalData.branch_name = branch.Branch.BranchName;
                branchService.branch_ID = branch.BranchId;
                globalData.login_id = branch.Id;

                if (!branch.IsActive)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"สาขา {branch.Branch.BranchName} ปิดกิจการ");
                }

                NavManager.NavigateTo($"/dashboard/{branch.BranchId}", true);
            }
        }
    }
}
